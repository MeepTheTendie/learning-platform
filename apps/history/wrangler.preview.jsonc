{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "learning-history-preview",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-08",
  "d1_databases": [
    {
      "binding": "PROGRESS_DB",
      "database_name": "learning-platform-preview",
      "database_id": "62dd3923-e3e5-4454-b764-655d4e2714da"
    }
  ],
  "vars": {
    "APP_ID": "history-atlas",
    "STORAGE_KEY": "civilization-atlas-v1",
    "AUTH_MODE": "access",
    "ACCESS_ISSUER": "https://meep-learning.cloudflareaccess.com",
    "ACCESS_AUD": "3daa311318c0dc5e77b5cefe48c7791af010302a122dbf047e5600ca8b0a8a3b",
    "OWNER_EMAIL": "wesleympennock@gmail.com",
    "TUTOR_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8",
    "TUTOR_DAILY_LIMIT": "40",
    "TUTOR_ENABLED": "true"
  },
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/__cloud-sync.js",
      "/assets/robinson/images/*"
    ]
  },
  "workers_dev": true
}
