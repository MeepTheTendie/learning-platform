{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "geography-atlas",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-08",
  "d1_databases": [
    {
      "binding": "PROGRESS_DB",
      "database_name": "learning-progress-sync",
      "database_id": "5a9273d4-9360-4a6e-a146-cb432e68f03b"
    }
  ],
  "vars": {
    "APP_ID": "geography-atlas",
    "STORAGE_KEY": "geography-atlas-v1",
    "PEER_VALIDATE_URL": "https://history-atlas.history-atlas.workers.dev/api/progress",
    "TUTOR_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8",
    "TUTOR_DAILY_LIMIT": "40",
    "TUTOR_ENABLED": "true"
  },
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/__cloud-sync.js"
    ]
  }
}
