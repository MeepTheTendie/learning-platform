{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "learning-geography-preview",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-08",
  "d1_databases": [
    {
      "binding": "PROGRESS_DB",
      "database_name": "learning-platform-preview",
      "database_id": "62dd3923-e3e5-4454-b764-655d4e2714da"
    }
  ],
  "vars": {
    "APP_ID": "geography-atlas",
    "STORAGE_KEY": "geography-atlas-v1",
    "KEY_SCOPE": "app",
    "TUTOR_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8",
    "TUTOR_DAILY_LIMIT": "40",
    "TUTOR_ENABLED": "true"
  },
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/__cloud-sync.js"
    ]
  },
  "workers_dev": true
}
