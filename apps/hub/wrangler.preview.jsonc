{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "learning-hub-preview",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-08",
  "d1_databases": [
    {
      "binding": "PROGRESS_DB",
      "database_name": "learning-platform-preview",
      "database_id": "62dd3923-e3e5-4454-b764-655d4e2714da"
    }
  ],
  "vars": {
    "APP_ID": "learning-hub",
    "STORAGE_KEY": "learning-hub-v1",
    "KEY_SCOPE": "app"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/__cloud-sync.js"
    ]
  },
  "workers_dev": true
}
