{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "sourcebook",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-08",
  "d1_databases": [
    {
      "binding": "PROGRESS_DB",
      "database_name": "learning-progress-sync",
      "database_id": "5a9273d4-9360-4a6e-a146-cb432e68f03b"
    }
  ],
  "vars": {
    "APP_ID": "sourcebook",
    "TUTOR_ENABLED": "true",
    "TUTOR_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8",
    "TUTOR_DAILY_LIMIT": "40"
  },
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
